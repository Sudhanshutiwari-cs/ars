# ============================================================================
# Google Sheets Webhook Configuration for ARS Imperial Landmark
# ============================================================================
# Option 1: Single Shared Webhook URL for both Careers & Contact pages (Recommended)
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Option 2: Separate Webhook URLs if you want separate Google Spreadsheets
# GOOGLE_SHEETS_CAREERS_URL=https://script.google.com/macros/s/CAREERS_SCRIPT_ID/exec
# GOOGLE_SHEETS_CONTACT_URL=https://script.google.com/macros/s/CONTACT_SCRIPT_ID/exec
